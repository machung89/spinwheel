# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://spinwheelge.com

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container (optional), e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher ID (optional), e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot IDs (optional; leave empty to rely on Auto ads only)
NEXT_PUBLIC_AD_SLOT_BELOW_WHEEL=
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_ARTICLE_END=
# Auto ads are switched on/off in the AdSense dashboard (Ads > By site); the script above enables them.

# Contact address shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@spinwheelge.com

# Server-only: YouTube Data API v3 key for the YouTube Comment Picker (optional)
YOUTUBE_API_KEY=
